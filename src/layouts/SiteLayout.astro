---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = site.defaultTitle,
  description = site.defaultDescription,
  type = 'website',
  schema,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const defaultSchema = {
  '@type': 'WebApplication',
  name: site.name,
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'Any',
  url: canonical.toString(),
  description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [defaultSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-WPF5GVC931"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      // Keep Google's official command-queue shape; gtag.js expects the arguments object.
      // eslint-disable-next-line prefer-rest-params
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-WPF5GVC931');
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og-card.svg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og-card.svg', Astro.site)} />
    <meta name="theme-color" content="#f7f5ef" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {schemas.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', ...item })} />)}
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label={`${site.name} home`}><span class="brand-mark">C</span><span>{site.name}</span></a>
      <nav aria-label="Main navigation">
        <a href="/watermark-remover">Watermark remover</a>
        <a href="/blog">Guides</a>
        <a href="/#how-it-works">How it works</a>
      </nav>
      <a class="header-cta" href="/#tool">Try it free <span>→</span></a>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div><a class="brand" href="/"><span class="brand-mark">C</span><span>{site.name}</span></a><p>Simple, private image cleanup for work you own.</p></div>
      <div class="footer-links"><a href="/privacy">Privacy</a><a href="/terms">Terms</a><a href="/blog">Guides</a></div>
      <p>© {new Date().getFullYear()} {site.name}</p>
    </footer>
  </body>
</html>
