---
import ResponsiveImage from './ResponsiveImage.astro';
import { ChevronsLeftRight, Sparkle } from '@lucide/astro';
import type { z } from 'zod';
import type { landingComparisonSchema } from '../lib/content/landing-design';

interface Props {
  image: string;
  alt: string;
  comparison: z.infer<typeof landingComparisonSchema>;
  sampleId?: string;
  eager?: boolean;
  sizes?: string;
}
const { image, alt, comparison, sampleId, eager = false, sizes = '(max-width: 900px) calc(100vw - 40px), 640px' } = Astro.props;
---
<div class:list={['landing-compare', 'hero-compare', `style-${comparison.style ?? 'watermark'}`, sampleId && `sample-${sampleId}`]} data-landing-compare style="--compare-position:50%" role="group" aria-label={`Illustrative comparison: ${alt}`}>
  <ResponsiveImage src={image} alt={alt} sizes={sizes} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} />
  {comparison.beforeImage ? <div class="landing-before-image" aria-hidden="true"><ResponsiveImage src={comparison.beforeImage} alt="" sizes={sizes} /></div> :
    <div class="landing-watermark" aria-hidden="true"><span class="landing-watermark-badge gemini-mark">{comparison.style === 'gemini' && <Sparkle size={37} fill="currentColor" stroke-width={0} />}<b>{comparison.watermark ?? (comparison.style === 'gemini' ? 'GEMINI' : 'watermark')}</b>{comparison.style === 'gemini' && <small>AI GENERATED</small>}</span></div>}
  <b class="compare-label before">Before</b><b class="compare-label after">After</b>
  <span class="compare-line" aria-hidden="true"><ChevronsLeftRight size={18} /></span>
  <input class="compare-control" type="range" min="0" max="100" value="50" aria-label={`Compare original and cleaned illustration: ${alt}`} />
</div>
