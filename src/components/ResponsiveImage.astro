---
import { buildOptimizedImageSrcSet } from '../lib/content/optimized-image';
import { IMAGE_PLACEHOLDER_DIMENSIONS, IMAGE_PLACEHOLDER_SRC, resolvePublicImageSource } from '../lib/content/image-fallback';
import { resolvePublicImageDimensions } from '../lib/content/public-image-dimensions';

interface Props {
  src: string;
  alt: string;
  class?: string;
  sizes: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  src,
  alt,
  class: className,
  sizes,
  loading = 'lazy',
  fetchpriority,
} = Astro.props;
const resolvedSrc = resolvePublicImageSource(src);
const isFallback = resolvedSrc === IMAGE_PLACEHOLDER_SRC && resolvedSrc !== src;
const dimensions = isFallback ? IMAGE_PLACEHOLDER_DIMENSIONS : resolvePublicImageDimensions(resolvedSrc);
const srcSet = !isFallback && dimensions ? buildOptimizedImageSrcSet(resolvedSrc, dimensions.width) : undefined;
---
{srcSet ? (
  <picture class:list={['responsive-picture', className]}>
    <source type="image/webp" srcset={srcSet} sizes={sizes} />
    <img src={resolvedSrc} alt={alt} width={dimensions?.width} height={dimensions?.height} loading={loading} decoding="async" fetchpriority={fetchpriority} />
  </picture>
) : (
  <img class={className} src={resolvedSrc} alt={alt} width={dimensions?.width} height={dimensions?.height} loading={loading} decoding="async" fetchpriority={fetchpriority} data-image-fallback={isFallback ? 'true' : undefined} />
)}
