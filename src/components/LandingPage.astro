---
import ImageUploader from './uploader/ImageUploader';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

interface Props { page: CollectionEntry<'landingPages'>['data'] }
const { page } = Astro.props;
const [siteEntry] = await getCollection('siteSettings');
if (!siteEntry) throw new Error('Site settings CMS content is missing.');
const site = siteEntry.data;
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: page.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<SiteLayout title={page.title} description={page.description} schema={faqSchema}>
  <section class="hero compact-hero">
    <div class="hero-copy">
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{page.heading}</h1>
      <p>{page.intro}</p>
      <ul class="check-list">{page.benefits.map((benefit) => <li>{benefit}</li>)}</ul>
    </div>
    <div id="tool" class="hero-tool"><ImageUploader logo={site.logo} siteName={site.name} copy={site.uploader} client:load /></div>
  </section>

  <section class="section process-section" id="how-it-works">
    <div class="section-heading"><span class="eyebrow">{page.process.eyebrow}</span><h2>{page.process.heading}</h2><p>{page.process.intro}</p></div>
    <div class="steps">
      {page.process.steps.map((step) => <article><span>{step.number}</span><h3>{step.title}</h3><p>{step.description}</p></article>)}
    </div>
  </section>

  <section class="section faq-section">
    <div class="section-heading"><span class="eyebrow">{page.faq.eyebrow}</span><h2>{page.faq.heading}</h2><p>{page.faq.intro}</p></div>
    <div class="faq-list">{page.faq.items.map((item) => <details><summary>{item.question}<span>+</span></summary><p>{item.answer}</p></details>)}</div>
  </section>
</SiteLayout>
