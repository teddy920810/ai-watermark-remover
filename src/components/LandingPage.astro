---
import ImageUploader from './uploader/ImageUploader';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { splitFeatureCopy } from '../lib/content/feature-copy';

interface Props { page: CollectionEntry<'landingPages'>['data'] }
const { page } = Astro.props;
const [commonEntry] = await getCollection('landingCommonSettings');
if (!commonEntry) throw new Error('Landing-page shared CMS settings are missing.');
const [siteEntry] = await getCollection('siteSettings');
if (!siteEntry) throw new Error('Site settings CMS content is missing.');
const common = commonEntry.data;
const site = siteEntry.data;
const features = page.features;
const featureItems = features?.items.map((item) => ({
  ...item,
  copy: splitFeatureCopy(item.description, item.listItems),
})) ?? [];
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: page.faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<SiteLayout title={page.title} description={page.description} schema={faqSchema}>
  <section class="hero compact-hero">
    <div class="hero-copy">
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{page.heading}</h1>
      <p>{page.intro}</p>
      <ul class="check-list">{page.benefits.map((benefit) => <li>{benefit}</li>)}</ul>
    </div>
    <div id="tool" class="hero-tool"><ImageUploader logo={site.logo} siteName={site.name} copy={site.uploader} client:load /></div>
  </section>

  <section class="section process-section" id="how-it-works">
    <div class="section-heading"><span class="eyebrow">{common.process.eyebrow}</span><h2>{common.process.heading}</h2></div>
    <div class="steps">
      {common.process.steps.map((step) => <article><span>{step.number}</span><h3>{step.title}</h3><p>{step.description}</p></article>)}
    </div>
  </section>

  {features && featureItems.length ? (
    <section class="section features-section landing-features-section" aria-labelledby="features-heading">
      <div class="section-heading"><span class="eyebrow">{features.eyebrow}</span><h2 id="features-heading">{features.heading}</h2><p>{features.intro}</p></div>
      <div class="feature-list">
        {featureItems.map((item) => <article class:list={{ 'feature-item': true, 'is-image-left': item.imagePosition === 'left' }}>
          <div class="feature-copy"><span class="eyebrow">{item.eyebrow}</span><h3>{item.heading}</h3><p>{item.copy.description}</p>{item.copy.listItems.length > 0 && <ul class="feature-list-items">{item.copy.listItems.map((listItem) => <li>{listItem}</li>)}</ul>}</div>
          <div class="feature-media"><img src={item.image} alt={item.imageAlt} loading="lazy" /></div>
        </article>)}
      </div>
    </section>
  ) : null}

  <section class="section faq-section">
    <div class="section-heading"><span class="eyebrow">{common.faq.eyebrow}</span><h2>{common.faq.heading}</h2></div>
    <div class="faq-list">{page.faq.map((item) => <details><summary>{item.question}<span>+</span></summary><p>{item.answer}</p></details>)}</div>
  </section>
</SiteLayout>
