---
import ImageUploader from './uploader/ImageUploader';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { splitFeatureCopy } from '../lib/content/feature-copy';
import { resolvePublicImageDimensions } from '../lib/content/public-image-dimensions';
import { visibleItems } from '../lib/content/item-visibility';
import { resolveUploaderCopy } from '../lib/content/site-settings';
import { ArrowRight, CircleCheck, CloudUpload, Download, Plus, Sparkles, WandSparkles } from '@lucide/astro';

interface Props { page: CollectionEntry<'landingPages'>['data'] }
const { page } = Astro.props;
const [siteEntry] = await getCollection('siteSettings');
if (!siteEntry) throw new Error('Site settings CMS content is missing.');
const site = siteEntry.data;
const uploaderCopy = resolveUploaderCopy(site.uploader, page.uploader);
const features = page.features;
const featureItems = visibleItems(features?.items ?? []).map((item) => ({
  ...item,
  copy: splitFeatureCopy(item.description, item.listItems),
  dimensions: resolvePublicImageDimensions(item.image),
}));
const visibleFaqItems = visibleItems(page.faq.items);
const processIcons = [CloudUpload, WandSparkles, Download];
const faqSchema = visibleFaqItems.length > 0 ? {
  '@type': 'FAQPage',
  mainEntity: visibleFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : undefined;
---

<SiteLayout title={page.title} description={page.description} schema={faqSchema}>
  <section class="hero compact-hero">
    <div class="hero-copy">
      <span class="eyebrow">{page.eyebrow}</span>
      <h1>{page.heading}</h1>
      <p>{page.intro}</p>
      <ul class="check-list">{page.benefits.map((benefit) => <li><CircleCheck size={19} stroke-width={2.5} />{benefit}</li>)}</ul>
    </div>
    <div id="tool" class="hero-tool"><ImageUploader logo={site.logo} siteName={site.name} copy={uploaderCopy} client:load /></div>
  </section>

  <section class="section process-section" id="how-it-works">
    <div class="section-heading"><span class="eyebrow">{page.process.eyebrow}</span><h2>{page.process.heading}</h2><p>{page.process.intro}</p></div>
    <div class="steps">
      {page.process.steps.map((step, index) => {
        const Icon = processIcons[index] ?? Sparkles;
        return <><article><span class="step-number">{step.number}</span><span class="step-icon"><Icon size={28} stroke-width={2} /></span><h3>{step.title}</h3><p>{step.description}</p></article>{index < page.process.steps.length - 1 && <span class="step-arrow" aria-hidden="true"><ArrowRight size={21} stroke-width={2.2} /></span>}</>;
      })}
    </div>
  </section>

  {features && featureItems.length ? (
    <section class="section features-section landing-features-section" aria-labelledby="features-heading">
      <div class="section-heading"><span class="eyebrow">{features.eyebrow}</span><h2 id="features-heading">{features.heading}</h2><p>{features.intro}</p></div>
      <div class="feature-list">
        {featureItems.map((item) => <article class:list={{ 'feature-item': true, 'is-image-left': item.imagePosition === 'left' }}>
          <div class="feature-copy"><span class="eyebrow">{item.eyebrow}</span><h3>{item.heading}</h3><p>{item.copy.description}</p>{item.copy.listItems.length > 0 && <ul class="feature-list-items">{item.copy.listItems.map((listItem) => <li>{listItem}</li>)}</ul>}</div>
          <div class="feature-media"><img src={item.image} alt={item.imageAlt} loading="lazy" decoding="async" width={item.dimensions?.width} height={item.dimensions?.height} /></div>
        </article>)}
      </div>
    </section>
  ) : null}

  {visibleFaqItems.length > 0 && <section class="section faq-section">
    <div class="section-heading"><span class="eyebrow">{page.faq.eyebrow}</span><h2>{page.faq.heading}</h2><p>{page.faq.intro}</p></div>
    <div class="faq-list">{visibleFaqItems.map((item) => <details><summary>{item.question}<span aria-hidden="true"><Plus size={20} /></span></summary><p>{item.answer}</p></details>)}</div>
  </section>}
</SiteLayout>
