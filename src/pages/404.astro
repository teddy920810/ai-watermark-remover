---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
export const prerender = true;
const [settingsEntry] = await getCollection('notFoundSettings');
if (!settingsEntry) throw new Error('404 CMS settings are missing.');
const settings = settingsEntry.data;
---
<SiteLayout title={settings.title} description={settings.description} noindex={true}><header class="legal-page"><span class="eyebrow">{settings.eyebrow}</span><h1>{settings.heading}</h1><p>{settings.intro}</p><p><a class="button button-primary" href={settings.buttonHref}>{settings.buttonLabel}</a></p></header></SiteLayout>
