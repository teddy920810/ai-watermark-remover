---
import ImageUploader from '../components/uploader/ImageUploader';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { sortBlogEntries } from '../lib/content/entries';

export const prerender = true;
const blogPosts = sortBlogEntries(await getCollection('blog')).slice(0, 2);
---

<SiteLayout>
  <section class="hero home-hero">
    <div class="hero-copy">
      <span class="eyebrow">Fast · private · effortless</span>
      <h1>Clean images.<br /><em>Keep the focus.</em></h1>
      <p>Remove visible watermarks, logos, and text from images with a focused workflow that respects your privacy.</p>
      <div class="trust-row"><span>✓ No signup</span><span>✓ Up to 10 MB</span><span>✓ Deleted after 24h</span></div>
    </div>
    <div id="tool" class="hero-tool"><ImageUploader client:load /></div>
  </section>

  <section class="use-cases" aria-label="Popular tools">
    <a href="/remove-logo-from-image"><span class="case-icon">◎</span><span><strong>Remove logos</strong><small>Clean product and brand images</small></span><b>→</b></a>
    <a href="/remove-text-from-image"><span class="case-icon">T</span><span><strong>Remove text</strong><small>Erase unwanted text overlays</small></span><b>→</b></a>
    <a href="/remove-gemini-watermark"><span class="case-icon">✦</span><span><strong>Gemini marks</strong><small>Clean visible AI labels</small></span><b>→</b></a>
  </section>

  <section class="section process-section" id="how-it-works">
    <div class="section-heading"><span class="eyebrow">How it works</span><h2>A clean image in three steps</h2><p>No layers, brushes, or complicated settings.</p></div>
    <div class="steps">
      <article><span>01</span><h3>Upload</h3><p>Choose a JPG, PNG, or WEBP image. It goes directly to private storage.</p></article>
      <article><span>02</span><h3>Process</h3><p>Our provider-ready pipeline prepares a result without exposing storage credentials.</p></article>
      <article><span>03</span><h3>Download</h3><p>Review the before and after, then use a short-lived link to save your image.</p></article>
    </div>
  </section>

  <section class="section standards-section">
    <div><span class="eyebrow">Made for peace of mind</span><h2>Your images are yours</h2><p>Uploads live in private storage, access links expire, and objects are designed for automatic deletion after 24 hours.</p><a class="text-link" href="/privacy">Read our privacy approach →</a></div>
    <div class="standards-card"><div><span>◇</span><strong>Private bucket</strong><small>No permanent public image URL</small></div><div><span>◷</span><strong>24-hour retention</strong><small>Short-lived uploads and results</small></div><div><span>⌁</span><strong>Secure links</strong><small>Time-limited access by default</small></div></div>
  </section>

  <section class="section guides-section">
    <div class="section-heading row-heading"><div><span class="eyebrow">Helpful guides</span><h2>Make better image choices</h2></div><a class="text-link" href="/blog">View all guides →</a></div>
    <div class="guide-grid">{blogPosts.map(({ data: post }) => <article><span>{post.readTime}</span><h3><a href={`/blog/${post.slug}`}>{post.title}</a></h3><p>{post.description}</p><a class="text-link" href={`/blog/${post.slug}`}>Read guide →</a></article>)}</div>
  </section>
</SiteLayout>
