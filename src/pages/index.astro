---
import '../styles/home-blueprint.css';
import '../styles/home-integration.css';
import HomeComparison from '../components/HomeComparison.astro';
import HomeReviews from '../components/HomeReviews.astro';
import MediaLauncher from '../components/launcher/MediaLauncher';
import HighlightedHeading from '../components/HighlightedHeading.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { sortBlogEntries } from '../lib/content/entries';
import { splitFeatureCopy } from '../lib/content/feature-copy';
import { visibleItems } from '../lib/content/item-visibility';
import { resolveUploaderCopy } from '../lib/content/site-settings';
import { ArrowLeft, ArrowRight, BadgeDollarSign, CircleCheck, Clock3, Link2, Plus, ShieldCheck } from '@lucide/astro';

export const prerender = true;
const [homepage] = await getCollection('homepage');
if (!homepage) throw new Error('Homepage CMS content is missing.');
const [siteEntry] = await getCollection('siteSettings');
if (!siteEntry) throw new Error('Site settings CMS content is missing.');
const home = homepage.data;
const site = siteEntry.data;
const uploaderCopy = resolveUploaderCopy(site.uploader, home.uploader);
const blogPosts = sortBlogEntries(await getCollection('blog')).slice(0, 6);
const landingPages = await getCollection('landingPages');
const publishedToolPaths = new Set(landingPages.filter(({ data }) => !data.draft && !data.statusLabel).map(({ data }) => '/' + data.slug));
const popularTools = home.removalTools.cards.filter(item => item.href === '/#tool' || publishedToolPaths.has(item.href));
const guideColumns = [blogPosts.slice(0, 3), blogPosts.slice(3, 6)];
const featureItems = visibleItems(home.features.items).map((item) => ({
  ...item,
  copy: splitFeatureCopy(item.description, item.listItems),
}));
const visibleFaqItems = visibleItems(home.faq.items);
const privacyIcons = [ShieldCheck, Clock3, Link2, BadgeDollarSign];
const faqSchema = visibleFaqItems.length > 0 ? {
  '@type': 'FAQPage',
  mainEntity: visibleFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : undefined;
---

<SiteLayout title={home.title} description={home.description} image={home.shareImage} schema={faqSchema}>
  <div class="home-blueprint">
  <section class="hero home-hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <span class="eyebrow">{home.hero.eyebrow}</span>
        <h1>{home.hero.heading} <em>{home.hero.highlightedHeading}</em></h1>
        <p class="intro">{home.hero.intro}</p>
      </div>
      <div class="hero-workbench">
        <div class="compare-panel">
          {home.hero.samples.map((sample,index) => <div data-hero-preview={index} hidden={index!==0}><HomeComparison image={sample.image} alt={sample.label} watermark={sample.watermark} sampleId={sample.id} eager={index===0} /></div>)}
          <div class="preview-samples" aria-label="Choose a preview sample">{home.hero.samples.map((sample,index) => <button class="sample-thumb" type="button" data-hero-sample={index} aria-pressed={index===0?'true':'false'} aria-label={sample.label}><span class="sample-art"><ResponsiveImage src={sample.image} alt="" sizes="64px" /></span><span>{sample.label}</span></button>)}</div>
          <p class="illustration-note">{home.hero.previewNote}</p>
        </div>
        <div id="tool" class="hero-tool upload-panel"><MediaLauncher kind="image" source="homepage" copy={uploaderCopy} client:load /><p class="privacy-line">{home.hero.privacyNote}</p></div>
      </div>
      <div class="trust-row trust-list">{home.hero.trustItems.map(item => <span><CircleCheck size={16} />{item.replace(/^✓\s*/, '')}</span>)}</div>
    </div>
  </section>

  <section class="section process-section" id="how-it-works">
    <div class="section-heading"><span class="eyebrow">{home.process.eyebrow}</span><HighlightedHeading text={home.process.heading} highlight={home.process.headingHighlight} /><p>{home.process.intro}</p></div>
    <div class="steps">
      {home.process.steps.map((step, index) => {
        const visual = site.processVisuals[index];
        return <article><div class="process-step-media"><ResponsiveImage src={step.image ?? visual.image} alt={step.imageAlt ?? visual.imageAlt} sizes="(max-width: 900px) calc(100vw - 40px), 360px" /></div><div class="process-step-copy"><span class="step-number">{step.number}</span><h3>{step.title}</h3><p>{step.description}</p></div></article>;
      })}
    </div>
  </section>

  <section class="section results-section" id="results" aria-labelledby="results-heading" data-scenario-section>
    <div class="section-heading"><span class="eyebrow">{home.useCaseSection.eyebrow}</span><HighlightedHeading id="results-heading" text={home.useCaseSection.heading} highlight={home.useCaseSection.headingHighlight} /><p>{home.useCaseSection.intro}</p></div>
    <div class="scenario-tabs result-tabs" role="tablist" aria-label="Image cleanup scenarios">{home.useCases.map((item,index) => <button id={'scenario-tab-'+index} type="button" role="tab" aria-selected={index===0?'true':'false'} aria-controls={'scenario-panel-'+index} tabindex={index===0?0:-1} data-scenario-tab={index}><strong>{item.title}</strong></button>)}</div>
    <div class="scenario-showcase">
      {home.useCases.map((item,index) => <article id={'scenario-panel-'+index} role="tabpanel" aria-labelledby={'scenario-tab-'+index} class:list={['scenario-panel',{'is-active':index===0}]} data-scenario-panel={index} hidden={index!==0}>
        <div class="scenario-stage"><HomeComparison image={item.image} alt={item.imageAlt} watermark={item.watermark} comparisonStyle={item.comparisonStyle} sizes="(max-width:760px) calc(100vw - 40px), 940px" />
          <div class="scenario-stage-controls"><button type="button" data-scenario-direction="previous" aria-label="Previous scenario"><ArrowLeft size={18} /></button><button type="button" data-scenario-direction="next" aria-label="Next scenario"><ArrowRight size={18} /></button></div>
        </div><div class="scenario-caption result-copy"><p>{item.description}</p><a class="try-result-button" href={item.href}>{item.cta}</a></div>
      </article>)}
    </div>
  </section>

  {featureItems.length > 0 && <section class="section features-section" aria-labelledby="features-heading">
    <div class="section-heading"><span class="eyebrow">{home.features.eyebrow}</span><HighlightedHeading id="features-heading" text={home.features.heading} highlight={home.features.headingHighlight} /><p>{home.features.intro}</p></div>
    <div class="feature-list live-features">
      {featureItems.map((item) => <article class:list={{ 'feature-item': true, 'is-image-left': item.imagePosition === 'left' }}>
        <div class="feature-copy"><span class="eyebrow">{item.eyebrow}</span><h3>{item.heading}</h3><p>{item.copy.description}</p>{item.copy.listItems.length > 0 && <ul class="feature-list-items feature-labels">{item.copy.listItems.map((listItem) => <li>{listItem}</li>)}</ul>}</div>
        <div class="feature-media"><HomeComparison image={item.image} alt={item.imageAlt} watermark={item.watermark} comparisonStyle={item.comparisonStyle} /></div>
      </article>)}
    </div>
  </section>}

  <section class="section use-cases" aria-labelledby="audiences-heading">
    <div class="section-heading"><h2 id="audiences-heading">{home.audiences.heading}</h2><p>{home.audiences.intro}</p></div>
    <div class="use-case-grid audience-grid">{home.audiences.cards.map(card => <article class:list={['use-case-card',card.tone]}><div class="case-media"><ResponsiveImage src={card.image} alt={card.alt} sizes="(max-width:760px) calc(100vw - 40px), 400px" /></div><div class="case-copy"><h3>{card.title}</h3><p>{card.copy}</p><a href={card.href}>{card.cta}</a></div></article>)}</div>
  </section>
  <HomeReviews reviews={home.testimonials} />
  <section class="section removal-section" id="tools" aria-labelledby="removal-heading">
    <div class="section-heading"><span class="eyebrow">Popular tools</span><HighlightedHeading id="removal-heading" text={home.removalTools.heading} highlight="you want to remove" /><p>{home.removalTools.intro}</p></div>
    <div class="removal-grid"><div class="live-removal-grid">{popularTools.map(item => <a class="removal-card tool-card" href={item.href}><div class="tool-media"><ResponsiveImage src={item.image} alt={item.alt} sizes="(max-width:760px) calc(100vw - 40px), 300px" /></div><div class="tool-card-copy"><h3>{item.title}</h3><p>{item.copy}</p></div></a>)}</div></div>
  </section>

  <section class="section standards-section">
    <div><span class="eyebrow">{home.privacy.eyebrow}</span><HighlightedHeading text={home.privacy.heading} highlight={home.privacy.headingHighlight} /><p>{home.privacy.description}</p><a class="text-link" href={home.privacy.linkHref}>{home.privacy.linkLabel}</a></div>
    <div class="standards-card">{home.privacy.features.map((feature, index) => {
      const Icon = privacyIcons[index] ?? ShieldCheck;
      return <div><span><Icon size={21} stroke-width={2.1} /></span><strong>{feature.title}</strong><small>{feature.description}</small></div>;
    })}</div>
  </section>

  <section class="section guides-section">
    <div class="section-heading row-heading"><div><span class="eyebrow">{home.guides.eyebrow}</span><HighlightedHeading text={home.guides.heading} highlight={home.guides.headingHighlight} /><p>{home.guides.intro}</p></div><a class="outline-button" href={home.guides.linkHref}>{home.guides.linkLabel}</a></div>
    <div class="guides-list-grid">{guideColumns.map((column) => <ul class="guides-list">{column.map(({ data: post }) => <li><a href={`/blog/${post.slug}`}><span>{post.title}</span><ArrowRight size={18} aria-hidden="true" /></a></li>)}</ul>)}</div>
  </section>

  {visibleFaqItems.length > 0 && <section class="section faq-section home-faq-section" aria-labelledby="faq-heading">
    <div class="section-heading"><span class="eyebrow">{home.faq.eyebrow}</span><HighlightedHeading id="faq-heading" text={home.faq.heading} highlight={home.faq.headingHighlight} /><p>{home.faq.intro}</p></div>
    <div class="faq-list">{visibleFaqItems.map((item) => <details><summary>{item.question}<span aria-hidden="true"><Plus size={20} /></span></summary><p>{item.answer}</p></details>)}</div>
  </section>}
  </div>
</SiteLayout>

<script>
  import { initializeHomeInteractions } from '../lib/home-interactions';
  document.querySelectorAll<HTMLElement>('.home-blueprint').forEach(initializeHomeInteractions);
</script>
