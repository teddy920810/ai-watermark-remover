---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection } from 'astro:content';
import { sortBlogEntries } from '../../lib/content/entries';

export const prerender = true;
const blogPosts = sortBlogEntries(await getCollection('blog'));
---
<SiteLayout title="Image Cleanup Guides | ClearMark AI" description="Practical guides to image formats, responsible watermark removal, and better image cleanup workflows.">
  <header class="blog-hero"><span class="eyebrow">ClearMark guides</span><h1>Better images start with better choices</h1><p>Concise, practical advice for cleaning and exporting images responsibly.</p></header>
  <section class="blog-list">
    {blogPosts.map(({ data: post }) => <article><h2><a href={`/blog/${post.slug}`}>{post.title}</a></h2><p>{post.description}</p><small>{post.readTime}</small></article>)}
  </section>
</SiteLayout>
