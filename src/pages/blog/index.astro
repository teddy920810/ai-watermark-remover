---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { getCollection } from 'astro:content';
import { sortBlogEntries } from '../../lib/content/entries';
import { resolveBlogMetadata } from '../../lib/content/blog-metadata';
import { resolveImageAlt } from '../../lib/content/image-metadata';
import { buildCollectionPageSchema } from '../../lib/content/seo-schema';

export const prerender = true;
const blogPosts = sortBlogEntries(await getCollection('blog'));
const [settingsEntry] = await getCollection('blogIndexSettings');
if (!settingsEntry) throw new Error('Blog index CMS settings are missing.');
const settings = settingsEntry.data;
const [siteEntry] = await getCollection('siteSettings');
if (!siteEntry) throw new Error('Site settings CMS content is missing.');
const [imageSettingsEntry] = await getCollection('imageSettings');
if (!imageSettingsEntry) throw new Error('Image metadata CMS content is missing.');
const schema = buildCollectionPageSchema({
  canonicalOrigin: siteEntry.data.canonicalOrigin,
  path: '/blog',
  name: settings.heading,
  description: settings.description,
});
---
<SiteLayout title={settings.title} description={settings.description} image={settings.shareImage} schema={schema}>
  <header class="blog-hero"><span class="eyebrow">{settings.eyebrow}</span><h1>{settings.heading}</h1><p>{settings.intro}</p></header>
  <section class="blog-list">
    {blogPosts.slice(0, settings.postsPerPage).map(({ data: post }) => <article class:list={{ 'has-cover': post.coverImage }}>
      {post.coverImage && <ResponsiveImage class="blog-card-image" src={post.coverImage} alt={resolveImageAlt(post.coverImage, post.coverAlt, imageSettingsEntry.data.images, post.title)} sizes="(max-width: 900px) calc(100vw - 36px), 560px" />}
      <div><span class="article-category">{resolveBlogMetadata(post, siteEntry.data.contentDefaults, siteEntry.data.name).category}</span><h2><a href={`/blog/${post.slug}`}>{post.title}</a></h2><p>{post.description}</p></div>
      <small>{post.readTime}</small>
    </article>)}
  </section>
</SiteLayout>
