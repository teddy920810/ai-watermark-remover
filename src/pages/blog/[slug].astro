---
import SiteLayout from '../../layouts/SiteLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { sortBlogEntries } from '../../lib/content/entries';
import { resolveBlogMetadata } from '../../lib/content/blog-metadata';
import { resolveImageAlt } from '../../lib/content/image-metadata';
import { buildArticleSchema } from '../../lib/content/seo-schema';
import { optimizeTrustedHtmlImages } from '../../lib/content/optimized-html-images';
import { resolvePublicImageSource } from '../../lib/content/image-fallback';

export const prerender = true;
export async function getStaticPaths() {
  const posts = sortBlogEntries(await getCollection('blog'));
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const tableOfContents = headings.filter(({ depth }) => depth === 2);
const relatedPosts = sortBlogEntries(await getCollection('blog'))
  .filter(({ data }) => data.slug !== post.data.slug)
  .slice(0, 4);
const [siteEntry] = await getCollection('siteSettings');
if (!siteEntry) throw new Error('Site settings CMS content is missing.');
const metadata = resolveBlogMetadata(post.data, siteEntry.data.contentDefaults, siteEntry.data.name);
const [imageSettingsEntry] = await getCollection('imageSettings');
if (!imageSettingsEntry) throw new Error('Image metadata CMS content is missing.');
const coverAlt = post.data.coverImage
  ? resolveImageAlt(post.data.coverImage, post.data.coverAlt, imageSettingsEntry.data.images, post.data.title)
  : undefined;
const schema = buildArticleSchema({
  canonicalOrigin: siteEntry.data.canonicalOrigin,
  path: `/blog/${post.data.slug}`,
  title: post.data.title,
  description: post.data.description,
  publishedAt: post.data.publishedAt,
  updatedAt: post.data.updatedAt,
  author: metadata.author,
  publisherName: siteEntry.data.name,
  logo: resolvePublicImageSource(siteEntry.data.logo),
  image: post.data.coverImage ? resolvePublicImageSource(post.data.coverImage) : undefined,
});
const optimizedBodyHtml = post.data.bodyHtml ? optimizeTrustedHtmlImages(post.data.bodyHtml) : undefined;
---
<SiteLayout title={metadata.title} description={post.data.description} image={post.data.coverImage} type="article" schema={schema}>
  <header class="article-header"><div class="article-meta">{metadata.category} · {post.data.publishedAt} · {post.data.readTime} · {metadata.author}</div><h1>{post.data.title}</h1></header>
  <div class="article-layout">
    <aside class="article-toc">
      {tableOfContents.length > 0 && <nav class="article-sidebar-card" aria-labelledby="article-toc-heading">
        <h2 id="article-toc-heading">On this page</h2>
        <ol>
          {tableOfContents.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
        </ol>
      </nav>}
    </aside>
    <div class="article-main">
      {post.data.coverImage && <ResponsiveImage class="article-cover" src={post.data.coverImage} alt={coverAlt ?? ''} sizes="(max-width: 1100px) calc(100vw - 56px), 900px" loading="eager" fetchpriority="high" />}
      <article class="article-body">
        {post.data.contentMode === 'html' ? <div set:html={optimizedBodyHtml} /> : <Content />}
      </article>
    </div>
    <aside class="article-related" aria-labelledby="related-guides-heading">
      <div class="article-sidebar-card">
        <h2 id="related-guides-heading">Related guides</h2>
        <ul>
          {relatedPosts.map(({ data: relatedPost }) => <li>
            <a href={`/blog/${relatedPost.slug}`}>{relatedPost.title}</a>
            <span>{relatedPost.readTime}</span>
          </li>)}
        </ul>
      </div>
    </aside>
  </div>
</SiteLayout>
