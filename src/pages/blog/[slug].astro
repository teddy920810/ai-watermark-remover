---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { sortBlogEntries } from '../../lib/content/entries';

export const prerender = true;
export async function getStaticPaths() {
  const posts = sortBlogEntries(await getCollection('blog'));
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}
interface Props { post: CollectionEntry<'blog'> }
const { post } = Astro.props;
const { Content } = await render(post);
const schema = { '@type': 'Article', headline: post.data.title, description: post.data.description, datePublished: post.data.publishedAt, image: post.data.coverImage, author: { '@type': 'Organization', name: post.data.author } };
---
<SiteLayout title={`${post.data.title} | ClearMark AI`} description={post.data.description} image={post.data.coverImage} type="article" schema={schema}>
  <header class="article-header"><div class="article-meta">{post.data.category} · {post.data.publishedAt} · {post.data.readTime} · {post.data.author}</div><h1>{post.data.title}</h1><p>{post.data.description}</p></header>
  {post.data.coverImage && <img class="article-cover" src={post.data.coverImage} alt={post.data.coverAlt ?? post.data.title} />}
  <article class="article-body"><Content /></article>
</SiteLayout>
