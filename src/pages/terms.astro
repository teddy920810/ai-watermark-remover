---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getCollection, render } from 'astro:content';
export const prerender = true;
const page = (await getCollection('legalPages')).find((entry) => entry.data.slug === 'terms');
if (!page) throw new Error('Terms CMS content is missing.');
const { Content } = await render(page);
---
<SiteLayout title={page.data.title} description={page.data.description}>
  <header class="legal-page"><span class="eyebrow">{page.data.eyebrow}</span><h1>{page.data.heading}</h1></header>
  <article class="legal-body"><Content /></article>
</SiteLayout>
