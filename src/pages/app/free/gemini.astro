---
import FreeGeminiWorkspace from '../../../components/workspace/FreeGeminiWorkspace';
import site from '../../../content/settings/site.json';
import '../../../styles/design-system.css';
import '../../../styles/free-gemini.css';
import geminiLicense from '../../../vendor/gemini/LICENSE?raw';
import videoLicense from '../../../vendor/gemini/MEDIABUNNY-LICENSE?raw';
export const prerender = true;
const logo = process.env.BUILD_TARGET === 'app' ? `/_app-assets/public${site.logo}` : site.logo;
const analyticsId = import.meta.env.PROD ? site.analytics.googleMeasurementId : '';
---
<!doctype html><html lang={site.locale}><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex, follow" /><title>Free Gemini tool | {site.name}</title><meta name="description" content="Free Gemini image and video watermark removal on your device." /><link rel="icon" href={logo} />
{analyticsId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`}></script>}
{analyticsId && <script is:inline define:vars={{ analyticsId }}>
  window.dataLayer = window.dataLayer || [];
  // Official queue shape: https://developers.google.com/analytics/devguides/collection/ga4/events
  // eslint-disable-next-line prefer-rest-params
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', analyticsId);
</script>}
</head><body><FreeGeminiWorkspace logo={logo} siteName={site.name} client:only="react"><main slot="fallback" class="free-gemini-loading"><h1>Opening free Gemini tool</h1><p>Your file stays on this device. JavaScript is required to process it.</p></main></FreeGeminiWorkspace>
<details class="gemini-open-source"><summary>Open source notices</summary>
  <p>Gemini Watermark Remover v1.0.46 · MIT · <a href="https://github.com/GargantuaX/gemini-watermark-remover/tree/4fb1433649e01e626b7cae3c7ae02721e0ab0e65">Source code</a></p><pre>{geminiLicense}</pre>
  <p>Mediabunny v1.46.0 · MPL 2.0 · <a href="https://registry.npmjs.org/mediabunny/-/mediabunny-1.46.0.tgz">Complete unmodified source package</a></p><pre>{videoLicense}</pre>
</details></body></html>
