---
import AuthControls from '../../components/auth/AuthControls';
import CreditCheckout from '../../components/payments/CreditCheckout';
import { getPaymentConfig, publicPaymentCatalog } from '../../lib/payments/payment-config';
import { selectCheckoutSku } from '../../components/payments/checkout-selection';
import { safeReturnPath } from '../../components/payments/payment-client';
import site from '../../content/settings/site.json';
import '../../styles/design-system.css';
import '../../styles/payments.css';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'private, no-store');
const initialCatalog = publicPaymentCatalog(getPaymentConfig());
const initialSku = selectCheckoutSku(initialCatalog.packages, Astro.url.searchParams.get('sku'));
const returnTo = safeReturnPath(Astro.url.searchParams.get('returnTo'));
const appAsset = (path: string) => import.meta.env.BUILD_TARGET === 'app' ? `/_app-assets/public${path}` : path;
---
<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, follow" />
    <title>{initialCatalog.universalCredits ? 'Credits' : 'Image credits'} | {site.name}</title>
    <meta name="description" content="Purchase image credits and review your payment history." />
    <link rel="icon" href={appAsset(site.favicon)} />
  </head>
  <body class="credits-page">
    <header class="site-header credits-header">
      <a class="brand" href="/" aria-label={`${site.name} home`}><img class="brand-logo" src={appAsset(site.logo)} alt="" /><span>{site.name}</span></a>
      <nav aria-label="Checkout navigation"><a href="/app">Open app</a><a href={`/pricing?returnTo=${encodeURIComponent(returnTo)}`}>Pricing</a><a href="#orders">Your orders</a></nav>
      <div class="header-auth"><AuthControls client:load /></div>
    </header>
    <main class="pricing-page" aria-labelledby="pricing-heading">
      <a class="credits-back" href="/app/image">Back to image workspace</a>
      <div class="pricing-hero">
        <h1 id="pricing-heading">{initialCatalog.universalCredits ? 'Credits and orders' : 'Confirm your image credits'}</h1>
        <p class="pricing-intro">Review your selected plan, complete payment, and manage your orders.</p>
      </div>
      <CreditCheckout initialCatalog={initialCatalog} initialSku={initialSku} initialReturnTo={returnTo} client:load />
      <div class="pricing-terms">
        <p>One-time payment. No automatic renewal. Purchased image credits have no scheduled expiry, cannot be transferred, and cannot be exchanged for cash. Process only images you are authorized to edit.</p>
        {initialCatalog.universalCredits ? <p>Upgraded accounts use one Credits balance across all six operations. Existing orders keep their original quantities and payment amounts. Purchases remain unavailable until checkout opens.</p> : <p>These image credits do not cover PRO, brush refinement, or video processing.</p>}
        <p>Image files and results are temporary and expire after 24 hours. Download your results promptly. For purchase refunds, contact support with your order number before using the credits; used or disputed orders require review.</p>
        <p>Read our <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a> before buying.</p>
      </div>
    </main>
  </body>
</html>
