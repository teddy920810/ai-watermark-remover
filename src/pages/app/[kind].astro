---
import AppWorkspaceLayout from '../../layouts/AppWorkspaceLayout.astro';
export const prerender = true;
export function getStaticPaths() { return [{ params: { kind: 'image' } }, { params: { kind: 'video' } }]; }
const kind = Astro.params.kind === 'video' ? 'video' : 'image';
---
<AppWorkspaceLayout kind={kind} />
