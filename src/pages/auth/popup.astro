---
import { getCollection } from 'astro:content';
export const prerender = true;
const [siteEntry] = await getCollection('siteSettings');
if (!siteEntry) throw new Error('Site settings CMS content is missing.');
const site = siteEntry.data;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Google sign-in complete</title>
  </head>
  <body>
    <main class="popup-status">
      <img class="brand-logo" src={site.logo} alt={`${site.name} logo`} />
      <p>Sign-in complete. Returning to your upload…</p>
    </main>
    <script is:inline>
      if (window.opener) {
        window.opener.postMessage({ type: 'clearmark-auth-complete' }, window.location.origin);
        window.close();
      } else {
        window.location.replace('/#tool');
      }
    </script>
  </body>
</html>

<style>
  body { margin: 0; color: #172321; background: #f7f5ef; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  .popup-status { min-height: 100vh; display: grid; place-content: center; justify-items: center; gap: 18px; padding: 24px; text-align: center; }
  .brand-logo { width: 48px; height: 48px; display: block; object-fit: contain; }
</style>
