{
  "name": "ai-watermark-remover",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run images:optimize",
    "build": "astro check && astro build && npm run verify:responsive-images",
    "preview": "astro preview",
    "lint": "astro check && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke:production": "node scripts/production-smoke.mjs",
    "content:validate": "astro sync",
    "check:fast": "npm run content:validate && npm test",
    "check:content": "npm run content:validate && vitest run src/lib/content && npm run build",
    "check:ui": "vitest run src/layouts src/lib/content/blog-layout.test.ts src/lib/content/site-visual-system.test.ts src/lib/content/landing-pages.test.ts src/lib/content/homepage.test.ts src/lib/content/item-visibility.test.ts && playwright test tests/e2e/site-quality.spec.ts",
    "audit:dependencies": "npm audit --audit-level=high",
    "auth:import": "node scripts/import-google-credentials.mjs",
    "processing:import": "node scripts/import-processing-config.mjs",
    "processing:check": "node --env-file-if-exists=.env.local scripts/check-processing-connections.mjs",
    "blog:import-docx": "node scripts/import-blog-docx.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "verify:responsive-images": "node scripts/verify-responsive-images.mjs",
    "site:init": "node scripts/initialize-site.mjs",
    "site:validate": "node scripts/validate-site.mjs",
    "verify:deploy": "npm run site:validate && npm run test:coverage && npm run lint && npm run build",
    "verify": "npm run test:coverage && npm run lint && npm run build && npm run test:e2e",
    "release:verify": "npm run audit:dependencies && npm run site:validate && npm run verify"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/vercel": "^11.0.4",
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@lucide/astro": "^1.33.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "better-auth": "^1.6.26",
    "lucide-react": "^1.33.0",
    "pg": "^8.23.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/markdown-remark": "^7.2.2",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.33.0",
    "eslint-plugin-astro": "^1.3.1",
    "mammoth": "^1.12.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "path-to-regexp": "6.3.0",
    "nanoid": "3.3.18"
  }
}
