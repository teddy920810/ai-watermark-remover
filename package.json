{
  "name": "ai-watermark-remover",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "lint": "astro check && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke:production": "node scripts/production-smoke.mjs",
    "auth:import": "node scripts/import-google-credentials.mjs",
    "site:init": "node scripts/initialize-site.mjs",
    "verify:deploy": "npm run test:coverage && npm run lint && npm run build",
    "verify": "npm run test:coverage && npm run lint && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@astrojs/vercel": "^11.0.4",
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "better-auth": "^1.6.26",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.33.0",
    "eslint-plugin-astro": "^1.3.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "path-to-regexp": "6.3.0",
    "nanoid": "3.3.18"
  }
}

